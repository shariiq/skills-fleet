{
  "name": "skills-fleet",
  "version": "1.0.0",
  "description": "Central registry to track, install, and sync agent skills across machines",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "fleet:add": "bun run scripts/fleet.ts add",
    "fleet:remove": "bun run scripts/fleet.ts remove",
    "fleet:organize": "bun run scripts/fleet.ts organize",
    "fleet:list": "bun run scripts/fleet.ts list",
    "fleet:status": "bun run scripts/fleet.ts status",
    "fleet:install:global": "bun run scripts/fleet.ts install --global",
    "fleet:install:project": "bun run scripts/fleet.ts install",
    "fleet:clean:machine": "bun run scripts/fleet.ts clean --global",
    "fleet:clean:harnesses": "bun run scripts/fleet.ts clean-harnesses",
    "fleet:update": "bun run scripts/fleet.ts update",
    "fleet:sync": "bun run scripts/fleet.ts sync",
    "sync": "bun run scripts/fleet.ts sync",
    "fleet:uninstall:global": "bun run scripts/fleet.ts clean --global",
    "fleet:uninstall:project": "bun run scripts/fleet.ts clean",
    "fleet:wipe:machine": "bun run scripts/fleet.ts clean --global --all",
    "skills:list": "bunx skills list",
    "skills:list:global": "bunx skills list -g",
    "skills:remove": "bunx skills remove",
    "skills:remove:global": "bunx skills remove -g",
    "skills:update": "bunx skills update"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "latest"
  }
}
